{
  "name": "typesynth",
  "version": "0.1.0",
  "description": "A TypeScript source-generation CLI that allows for easy template-replacement",
  "keywords": [
    "cli",
    "code-generation",
    "handlebars",
    "hbs",
    "source-code-generation",
    "source-generation",
    "typescript"
  ],
  "homepage": "https://github.com/IvanKobtsev/TypeSynth#readme",
  "bugs": {
    "url": "https://github.com/IvanKobtsev/TypeSynth/issues"
  },
  "license": "MIT",
  "author": "xubarashi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanKobtsev/TypeSynth.git"
  },
  "bin": {
    "tsynth": "./dist/bin/cli.js",
    "typesynth": "./dist/bin/cli.js"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "render-examples": "tsc && npm run assets-helper && npm run ts-api-client && npm run csharp-url-helpers",
    "csharp-url-helpers": "typesynth generate --sources=examples/advanced_csharp-url-helpers/input --output=examples/advanced_csharp-url-helpers/Result.gen.cs",
    "ts-api-client": "typesynth generate --input=https://petstore3.swagger.io/api/v3/openapi.json --sources=examples/from-api_ts-api-client/input --output=examples/from-api_ts-api-client/Result.gen.ts",
    "assets-helper": "typesynth generate --sources=examples/simple_assets-helper/input --output=examples/simple_assets-helper/Result.gen.ts"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "esbuild-register": "^3.6.0",
    "handlebars": "^4.7.8",
    "json-stable-stringify": "^1.3.0",
    "node-fetch": "^2.7.0",
    "oxfmt": "^0.75.0",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/node-fetch": "^2.6.13",
    "react-router-url-params": "^0.9.2"
  }
}
